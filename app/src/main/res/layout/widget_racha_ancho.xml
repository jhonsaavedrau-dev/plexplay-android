<?xml version="1.0" encoding="utf-8"?>
<!-- Racha a lo ancho (4x2 o más, Android 12+): Manzana a la izquierda y, al lado, el mensaje, el número y la semana con letras -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/wr_cielo" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="4dp" android:paddingRight="14dp">
    <ImageView android:id="@+id/w_mz" android:layout_width="124dp" android:layout_height="match_parent" android:layout_marginBottom="-14dp"
        android:adjustViewBounds="true" android:scaleType="fitEnd" android:contentDescription="Manzana" android:src="@drawable/w2_saludar" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/w_msg" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/wr_bocadillo" android:paddingLeft="9dp" android:paddingTop="4dp" android:paddingRight="9dp" android:paddingBottom="5dp"
            android:maxLines="2" android:ellipsize="end" android:text="Cargando…" android:textColor="#FF1F2430" android:textSize="12.5sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/w_fuego" android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="Racha" android:src="@drawable/ic_flame" />
            <TextView android:id="@+id/w_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="3dp"
                android:text="" android:textColor="#FFFFFFFF" android:textSize="34sp" android:textStyle="bold" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowDy="2" android:shadowRadius="2" />
            <TextView android:id="@+id/w_lbl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6dp"
                android:text="" android:textColor="#F2FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp">
            <LinearLayout android:id="@+id/w_semana" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/w_d0" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginRight="4dp" android:background="@drawable/w8_dia_nada" android:gravity="center" android:text="L" android:textColor="#FFFFFFFF" android:textSize="9sp" android:textStyle="bold" /><TextView android:id="@+id/w_d1" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginRight="4dp" android:background="@drawable/w8_dia_nada" android:gravity="center" android:text="M" android:textColor="#FFFFFFFF" android:textSize="9sp" android:textStyle="bold" /><TextView android:id="@+id/w_d2" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginRight="4dp" android:background="@drawable/w8_dia_nada" android:gravity="center" android:text="M" android:textColor="#FFFFFFFF" android:textSize="9sp" android:textStyle="bold" /><TextView android:id="@+id/w_d3" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginRight="4dp" android:background="@drawable/w8_dia_nada" android:gravity="center" android:text="J" android:textColor="#FFFFFFFF" android:textSize="9sp" android:textStyle="bold" /><TextView android:id="@+id/w_d4" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginRight="4dp" android:background="@drawable/w8_dia_nada" android:gravity="center" android:text="V" android:textColor="#FFFFFFFF" android:textSize="9sp" android:textStyle="bold" /><TextView android:id="@+id/w_d5" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginRight="4dp" android:background="@drawable/w8_dia_nada" android:gravity="center" android:text="S" android:textColor="#FFFFFFFF" android:textSize="9sp" android:textStyle="bold" /><TextView android:id="@+id/w_d6" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginRight="0dp" android:background="@drawable/w8_dia_nada" android:gravity="center" android:text="D" android:textColor="#FFFFFFFF" android:textSize="9sp" android:textStyle="bold" /></LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
