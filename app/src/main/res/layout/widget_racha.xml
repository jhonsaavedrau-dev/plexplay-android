<?xml version="1.0" encoding="utf-8"?>
<!-- Racha (2x2): Manzana cambia según el día (celebra, duerme o saluda), los últimos 7 días y el estado de hoy -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/w_fuego" android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="Racha" android:src="@drawable/ic_flame_off" />
                <TextView android:id="@+id/w_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="4dp"
                    android:text="0" android:textColor="#FFFFFFFF" android:textSize="32sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/w_lbl" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="días de racha" android:textColor="#CCFFFFFF" android:textSize="12sp" />
        </LinearLayout>
        <ImageView android:id="@+id/w_mz" android:layout_width="68dp" android:layout_height="68dp" android:adjustViewBounds="true"
            android:contentDescription="Manzana" android:scaleType="fitEnd" android:src="@drawable/w_mz_saluda" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <ImageView android:id="@+id/w_d1" android:layout_width="11dp" android:layout_height="11dp" android:layout_marginRight="4dp" android:src="@drawable/widget_dot_off" />
        <ImageView android:id="@+id/w_d2" android:layout_width="11dp" android:layout_height="11dp" android:layout_marginRight="4dp" android:src="@drawable/widget_dot_off" />
        <ImageView android:id="@+id/w_d3" android:layout_width="11dp" android:layout_height="11dp" android:layout_marginRight="4dp" android:src="@drawable/widget_dot_off" />
        <ImageView android:id="@+id/w_d4" android:layout_width="11dp" android:layout_height="11dp" android:layout_marginRight="4dp" android:src="@drawable/widget_dot_off" />
        <ImageView android:id="@+id/w_d5" android:layout_width="11dp" android:layout_height="11dp" android:layout_marginRight="4dp" android:src="@drawable/widget_dot_off" />
        <ImageView android:id="@+id/w_d6" android:layout_width="11dp" android:layout_height="11dp" android:layout_marginRight="4dp" android:src="@drawable/widget_dot_off" />
        <ImageView android:id="@+id/w_d7" android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/widget_dot_hoy" />
    </LinearLayout>
    <TextView android:id="@+id/w_est" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp"
        android:background="@drawable/widget_chip" android:paddingLeft="10dp" android:paddingTop="3dp" android:paddingRight="10dp" android:paddingBottom="3dp"
        android:text="Empieza hoy" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" />
</LinearLayout>
