<?xml version="1.0" encoding="utf-8"?>
<!-- Meta de hoy (2x2), 1.8: anillo de XP con Manzana adentro (celebra al cumplirla) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w8_blanca" android:gravity="center" android:orientation="vertical" android:padding="8dp">
    <FrameLayout android:layout_width="104dp" android:layout_height="104dp">
        <ProgressBar android:id="@+id/w_anillo" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="match_parent"
            android:indeterminate="false" android:max="20" android:progress="0" android:progressDrawable="@drawable/w8_anillo" />
        <ProgressBar android:id="@+id/w_anillo_ok" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="match_parent"
            android:indeterminate="false" android:max="1" android:progress="1" android:progressDrawable="@drawable/w8_anillo_ok" android:visibility="gone" />
        <ImageView android:id="@+id/w_mz" android:layout_width="74dp" android:layout_height="74dp" android:layout_gravity="center" android:adjustViewBounds="true"
            android:contentDescription="Manzana" android:scaleType="fitCenter" android:src="@drawable/w2_lista" />
    </FrameLayout>
    <TextView android:id="@+id/w_xp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
        android:text="0 / 20 XP" android:textColor="#FF1F2430" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_est" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
        android:text="¡A practicar!" android:textColor="#FF5A6480" android:textSize="11sp" android:textStyle="bold" />
</LinearLayout>
