<?xml version="1.0" encoding="utf-8"?>
<!-- Palabra del día (4x1, crece a 4x2), 1.8: tarjeta blanca, la palabra grande, traducción, ejemplo y Manzana pensativo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w8_blanca" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="14dp" android:paddingRight="4dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/w8_chip_rosa"
            android:paddingLeft="7dp" android:paddingRight="7dp" android:paddingTop="1dp" android:paddingBottom="2dp"
            android:text="PALABRA DEL DÍA" android:textColor="#FFFFFFFF" android:textSize="9sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_fr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1"
            android:text="le quotidien" android:textColor="#FF1F2430" android:textSize="21sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_es" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
            android:text="el día a día" android:textColor="#FF2F6BFF" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_ex" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end"
            android:maxLines="2" android:textColor="#FF5A6480" android:textSize="11sp" android:textStyle="italic" android:visibility="gone" />
    </LinearLayout>
    <ImageView android:id="@+id/w_mz" android:layout_width="78dp" android:layout_height="match_parent" android:layout_marginBottom="-14dp" android:adjustViewBounds="true"
        android:contentDescription="Manzana" android:scaleType="fitEnd" android:src="@drawable/w2_pensativo" />
</LinearLayout>
