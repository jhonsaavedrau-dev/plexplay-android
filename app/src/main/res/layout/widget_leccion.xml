<?xml version="1.0" encoding="utf-8"?>
<!-- Continúa tu curso (4x1), 1.8: Manzana escribiendo, el curso, la siguiente lección y un botón redondo de «Empezar» -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w8_azul" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="4dp" android:paddingRight="12dp">
    <ImageView android:id="@+id/w_mz" android:layout_width="70dp" android:layout_height="match_parent" android:layout_marginBottom="-12dp" android:adjustViewBounds="true"
        android:contentDescription="Manzana" android:scaleType="fitEnd" android:src="@drawable/w2_estudiar" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/w_curso" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/w8_chip_claro"
            android:paddingLeft="7dp" android:paddingRight="7dp" android:paddingTop="1dp" android:paddingBottom="2dp" android:maxLines="1" android:ellipsize="end"
            android:text="CONTINÚA TU CURSO" android:textColor="#FFFFFFFF" android:textSize="9sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="2"
            android:text="Abre PLEX PLAY y elige tu curso" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/w_btn" android:layout_width="46dp" android:layout_height="46dp" android:layout_marginLeft="8dp" android:background="@drawable/w8_play"
        android:gravity="center" android:paddingLeft="3dp" android:text="▶" android:textColor="#FF1F2430" android:textSize="18sp" android:textStyle="bold" android:contentDescription="Empezar" />
</LinearLayout>
